# Copiá este archivo como .env (no se sube a Git). Nunca pegues secretos en el chat.
# Ruta al JSON de cliente OAuth descargado de Google Cloud Console (tipo "App de escritorio")
YOUTUBE_CLIENT_SECRET_FILE=secrets/client_secret.json
# Carpeta donde se guardan los tokens OAuth de cada canal (uno por canal)
YOUTUBE_TOKEN_DIR=secrets/tokens
# Publicación automática: dejá en 0 hasta revisar el lote. 1 = permite subir y programar.
AUTO_PUBLICAR=0
